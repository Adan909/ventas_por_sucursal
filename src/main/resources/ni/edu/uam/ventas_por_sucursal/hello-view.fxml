<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.ventas_por_sucursal.HelloController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Entrada (primera línea N, luego N líneas: sucursal importe)"/>
    <TextArea fx:id="txtEntrada" prefRowCount="12" VBox.vgrow="ALWAYS"
              promptText="5&#10;Leon 100&#10;Masaya 250&#10;Leon 200&#10;Granada 300&#10;Masaya 50"/>

    <HBox spacing="10">
        <Button text="Calcular" onAction="#onCalcular"/>
        <Button text="Limpiar" onAction="#onLimpiar"/>
    </HBox>

    <Label text="Sucursal ganadora y total:"/>
    <Label fx:id="lblResultado" style="-fx-font-size: 16px;"/>
</VBox>